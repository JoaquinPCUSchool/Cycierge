+@Composable
+fun RouteChip(modifier: Modifier = Modifier) {
+    val route by Api.route.collectAsState()
+    val (label, dot) = when (route) {
+        "LAN" -> "LAN" to Cy.Ok
+        "Funnel" -> "REMOTE" to Cy.Amber
+        "OFFLINE" -> "OFFLINE" to Cy.Low
+        else -> "CHECKING" to Cy.Mute
